@{
    Layout = "_LoginLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}

<div class="auth-wrapper">
    <div class="xp-window auth-dialog">
        <div class="xp-titlebar">
            <div class="xp-title">
                <span>Log On to SocialHub</span>
            </div>
        </div>

        <div class="xp-window-body flex-body">
            <div class="auth-icon-container">
                <img src="~/icons/people.png" alt="User" class="auth-large-icon" />
            </div>

            <form action="/User/Login" method="post" class="xp-form auth-form">
                <div asp-validation-summary="ModelOnly" class="xp-error-message"></div>
                <div class="xp-form-group">
                    <label class="xp-label">User name:</label>
                    <input type="text" name="Username" class="xp-input" required />
                </div>

                <div class="xp-form-group">
                    <label class="xp-label">Password:</label>
                    <input type="password" name="Password" class="xp-input" required />
                </div>

                <div class="xp-form-actions auth-actions">
                    <button type="submit" class="xp-btn-submit">OK</button>
                    <a href="/SocialHub/Posts" class="xp-btn-cancel">Cancel</a>
                </div>

                <div class="auth-links">
                    <a href="/User/SignUp">Don't have an account? Sign up here.</a>
                </div>
            </form>
        </div>
    </div>
</div>