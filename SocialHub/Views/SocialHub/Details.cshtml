@model Post

@{
	Layout = "_Layout";
}
@section Styles {
	<link rel="stylesheet" href="~/css/posts.css" />
	<link rel="stylesheet" href="~/css/single-post.css" />
}

<div class="single-post-container">
    <div class="post-card xp-large-window">
        <div class="post-header">
            <div class="header-info">
                <span class="post-author">@Model.Author</span>
                <span class="post-date">@Model.CreatedAt.ToString("MMM dd, yyyy - HH:mm")</span>
            </div>
            <a href="/SocialHub" class="xp-btn-back">Back to Hub</a>
        </div>

        <div class="post-body">
            <h3 class="post-title">@Model.Title</h3>
            <p class="post-text large-text">@Model.Text</p>

            <div class="post-actions">
                <a href="/SocialHub/Edit/@Model.Id" class="xp-btn-edit">Edit Post</a>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-form" 
                onsubmit="return confirm('Are you sure you want to delete this post?');">
                    <button type="submit" class="xp-btn-delete">Delete Post</button>
                </form>
            </div>
        </div>

        <div class="post-comments-expanded">
            @{
                int commentCount = Model.comments?.Count ?? 0;
            }
            <h4 class="comments-title">Comments (@commentCount)</h4>

            <div class="add-comment-box">
                <form asp-action="AddComment" method="post" class="comment-form">
                    <input type="hidden" name="PostId" value="@Model.Id" />
                    @if (User.Identity.IsAuthenticated)
                    {
                        <p class="xp-label">@User.Identity.Name</p>

                    }
                    else{ <input type="text" name="Author" class="xp-input author-input" placeholder="Your Name" required />}
                    <input type="text" name="Text" class="xp-input text-input" placeholder="Write a comment..." required />
                    <button type="submit" class="xp-btn-comment">Post</button>
                </form>
            </div>

            <div class="comments-list-expanded">
                @if (commentCount > 0)
                {
                    @foreach (var comment in Model.comments)
                    {
                        <div class="comment-item-large">
                            <div class="comment-bubble">
                                <span class="comment-author">@comment.Author:</span>
                                <span class="comment-text">@comment.Text</span>
                            </div>
                            <form asp-action="DeleteComment" asp-route-id="@comment.Id" asp-route-postId="@Model.Id" method="post">
                                <button type="submit" class="xp-btn-delete-small">x</button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <div class="no-comments">No comments yet. Be the first to reply!</div>
                }
            </div>
        </div>
    </div>
</div>