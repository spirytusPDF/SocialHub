@model SocialHub.Models.Post

@{
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/posts.css" />
    <link rel="stylesheet" href="~/css/edit-post.css" />
}

<div class="edit-post-container">
    <div class="xp-window">

        <div class="xp-titlebar">
            <div class="xp-title">
                <img src="~/icons/picture.png" alt="Icon" class="xp-icon" />
                <span>Edit Post - SocialHub</span>
            </div>
            <div class="xp-controls">
                <a href="/SocialHub/Details/@Model.Id" class="xp-close-btn" title="Cancel">X</a>
            </div>
        </div>

        <div class="xp-window-body">
            <form asp-action="Edit" class="xp-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="xp-form-group">
                    <label asp-for="Author" class="xp-label">Your Name:</label>
                    <input asp-for="Author" class="xp-input" required />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="xp-form-group">
                    <label asp-for="Title" class="xp-label">Post Title:</label>
                    <input asp-for="Title" class="xp-input" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="xp-form-group">
                    <label asp-for="Text" class="xp-label">Message:</label>
                    <textarea asp-for="Text" class="xp-input xp-textarea" rows="6" required></textarea>
                    <span asp-validation-for="Text" class="text-danger"></span>
                </div>

                <div class="xp-form-actions">
                    <button type="submit" class="xp-btn-submit">Save Changes</button>
                    <a href="/SocialHub/Details/@Model.Id" class="xp-btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>